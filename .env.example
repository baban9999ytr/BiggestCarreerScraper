# ─────────────────────────────────────────────────────────────────────────────
# Kariyer.net ATS Automation API — Environment Configuration
# Copy this file to .env and fill in your values before starting the service.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application Environment ───────────────────────────────────────────────────
# Set to "production" in deployed environments.
# When APP_ENV=production, ALLOWED_ORIGINS MUST be explicitly set or the
# service will refuse to start.
APP_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example (production): https://app.yourcompany.com,https://admin.yourcompany.com
# Example (development): http://localhost:3000,http://localhost:5173
# Do NOT use * — it is rejected when allow_credentials=True.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Kariyer.net Credentials ───────────────────────────────────────────────────
KARIYER_EMAIL=your-employer-email@example.com
KARIYER_PASSWORD=your-kariyer-password

# ── Session Configuration ─────────────────────────────────────────────────────
# Session time-to-live in seconds (default: 6 hours = 21600)
SESSION_TTL_SECONDS=21600

# ── Directory Paths ───────────────────────────────────────────────────────────
# Leave unset to use the defaults (./exports, ./screenshots, ./debug)
# EXPORT_DIR=/absolute/path/to/exports
# SCREENSHOT_DIR=/absolute/path/to/screenshots
# DEBUG_DIR=/absolute/path/to/debug

# ── Playwright Browser ───────────────────────────────────────────────────────
# Path to a headless Chrome/Chromium binary (Linux server deployments).
# Leave unset to let Playwright use its bundled browser.
# PLAYWRIGHT_CHROME=/opt/pw-browsers/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell

# ── Supabase (optional telemetry / data ingestion) ────────────────────────────
# If unset, Supabase upload is silently skipped.
# ROTATE THESE IMMEDIATELY if they were previously committed to source control.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ── CAPTCHA Solver (optional) ─────────────────────────────────────────────────
# Set CAPTCHA_PROVIDER and CAPTCHA_API_KEY for automatic CAPTCHA solving.
# Supported providers: capsolver, nocaptcha
# CAPTCHA_PROVIDER=capsolver
# CAPTCHA_API_KEY=your-capsolver-key
#
# Legacy single-key format (deprecated — still auto-translated on startup):
# CAPSOLVER_API_KEY=your-capsolver-key
# NO_CAPTCHA_AI_KEY=your-nocaptcha-ai-key

# ── CV Scrape Delay ────────────────────────────────────────────────────────────
# Seconds to wait between individual candidate CV page requests (default: 30).
# Increase this to reduce load on the ATS server.
# CV_SCRAPE_DELAY_SECONDS=30

# ── Outbound Proxy (optional) ─────────────────────────────────────────────────
# When set, applies to Playwright browser contexts and outbound HTTP clients.
# Use this for controlled network routing in restricted or audited environments.
# Format: http://host:port  or  http://user:pass@host:port
# Leave unset (default) to connect directly without a proxy.
# OUTBOUND_PROXY=http://proxy.example.com:8080

