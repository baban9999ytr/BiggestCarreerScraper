    "/download-export/{token}/{filename}": {
      "get": {
        "tags": [
          "System & Infrastructure"
        ],
        "summary": "Download Export",
        "description": "Serve a generated export file for an authenticated session.\n\nSecurity:\n- Token must map to a known session (any non-expired state).\n- Filename is validated against a strict allowlist before any filesystem access.\n- Path-traversal is prevented by both the regex and Path.resolve() confinement.\n- Only .json and .csv files inside the exports directory are served.",
        "operationId": "download_export_download_export__token___filename__get",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          },
          {
            "name": "filename",
            "in": "path",
